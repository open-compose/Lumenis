<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements for the Developer ID signature (sign-and-notarize.sh). The hardened runtime blocks
     audio input unless it is granted; Audio Punch-In needs it. It also refuses libraries signed by
     other teams: the CLAP host loads third-party plug-ins (docs/spec/clap-host.md), so library
     validation is turned off. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
