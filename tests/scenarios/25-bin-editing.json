[
  {
    "name": "Bin editing: a clip dragged in with Lift/Overwrite overwrites at the drop, with the marks it has in the Source monitor",
    "guide": "p.624",
    "clips": [{"name": "A"}, {"name": "C"}],
    "sequence": {"tracks": {"V1": [["A", 0, 100]], "A1": [["A", 0, 100]], "A2": [["A", 0, 100]]}},
    "steps": [
      {"load": "source", "clip": "C"},
      {"mark": "source", "in": 10, "out": 29, "at": 10},
