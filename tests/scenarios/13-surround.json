[
  {
    "name": "the Sequence Mix Format is set to 5.1 as one undo step; a 5.1 source track edits onto a new 5.1 track; setting the same format again changes nothing",
    "guide": "p.629, p.686",
    "clips": [{"name": "A"}, {"name": "F", "tracks": "A1-6", "formats": "5.1 A1A2A3A4A5A6"}],
    "sequence": {"tracks": {"A1": [["A", 0, 30]]}},
    "steps": [
      {"mix_format": "5.1"},
      {"command": "edit.undo"},
      {"command": "edit.redo"},
      {"mix_format": "5.1", "refused": true},
      {"load": "source", "clip": "F"},
      {"source_tracks": ["A1"]},
      {"command": "timeline.new.audio_track.5_1_surround"},
      {"patch": ["A1", "A3"]},
      {"mark": "source", "in": 0, "out": 9},
      {"mark": "record", "in": 0},
      {"command": "edit.overwrite"}
    ],
    "expect": {"A1": [["A", 0, 30]], "A3": [["F", 0, 10, "A1"]]},
    "expect_formats": {"A1": "mono", "A3": "5.1"},
    "expect_mix": "5.1"
  },
  {
    "name": "a 7.1 sequence goes back to stereo; undo makes it 7.1 again",
    "guide": "p.686",
    "clips": [{"name": "A"}],
    "sequence": {"tracks": {"A1": [["A", 0, 30]]}},
    "steps": [
      {"mix_format": "7.1"},
      {"mix_format": "stereo"},
      {"command": "edit.undo"}
    ],
    "expect": {"A1": [["A", 0, 30]]},
    "expect_mix": "7.1"
  }
]
